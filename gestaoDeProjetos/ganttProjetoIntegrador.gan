        <task id="6" name="Teste Prático" color="#6666ff" meeting="false" start="2026-08-24" duration="3" complete="0" thirdDate="2026-08-26" thirdDate-constraint="0" expand="true">
            <notes>
                <![CDATA[Criação de banco no ambiente de teste decisões sobre particionamento, clusterização, formatos de arquivo e estratégias de distribuição entram em jogo.
]]>
            </notes>
            <depend id="8" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="8" name="Normalização" color="#6666ff" meeting="false" start="2026-08-27" duration="2" complete="0" thirdDate="2026-08-17" thirdDate-constraint="0" expand="true">
            <notes>
                <![CDATA[A normalização é o processo de estruturar tabelas relacionais para eliminar dados redundantes e prevenir as três anomalias clássicas que levam a inconsistências ao longo do tempo: inserção, atualização e exclusão.]]>
            </notes>
            <depend id="9" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="9" name="Documentação" color="#6666ff" meeting="false" start="2026-08-31" duration="1" complete="0" thirdDate="2026-08-31" thirdDate-constraint="0" expand="true">

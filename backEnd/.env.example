# Copie para ".env" e preencha:   cp .env.example .env && chmod 600 .env
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# --- Banco de dados (PostgreSQL) ---
# API rodando no próprio servidor: use localhost. O banco do projeto se chama "sportfy".
DB_URL=jdbc:postgresql://localhost:5432/sportfy
DB_USER=back_sportfy
# senha passada pelo responsável do banco (pode ter @ % etc., não precisa de aspas)
DB_PASSWORD=
# schema onde estão as tabelas do Enzo (usuarios, partidas, quadras...)
DB_SCHEMA=public

# --- JWT ---
# Gere com: openssl rand -base64 64   (cole tudo numa linha só)
JWT_SECRET=cole-aqui-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=1440

# --- CORS: endereços do front, separados por vírgula ---
CORS_ORIGENS=http://localhost:3000,http://100.68.85.13:3000

# --- Outros ---
SERVER_PORT=8080
SWAGGER_ENABLED=true
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Chatbot SportIA (serviço Python do Gui, no mesmo servidor). Opcional.
# SPORTIA_URL=http://127.0.0.1:8001/chat

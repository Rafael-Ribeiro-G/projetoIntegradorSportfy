# Copie para ".env" e preencha:   cp .env.example .env && chmod 600 .env
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# --- Banco de dados (PostgreSQL) ---
# API rodando no próprio servidor: use localhost. Troque NOME_DO_BANCO pelo banco criado para o projeto.
DB_URL=jdbc:postgresql://localhost:5432/NOME_DO_BANCO
DB_USER=back_sportfy
# senha passada pelo responsável do servidor (pode ter @ % etc., não precisa de aspas)
DB_PASSWORD=
# schema onde o Flyway cria as tabelas (separado do "public")
DB_SCHEMA=sportfy

# --- JWT ---
# Gere com: openssl rand -base64 64   (cole tudo numa linha só)
JWT_SECRET=cole-aqui-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=1440

# --- CORS: endereços do front, separados por vírgula ---
CORS_ORIGENS=http://localhost:3000,http://100.68.85.13:3000

# --- Administrador criado na primeira subida (opcional) ---
ADMIN_EMAIL=
ADMIN_SENHA=

# --- Outros ---
SERVER_PORT=8080
SWAGGER_ENABLED=true
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
